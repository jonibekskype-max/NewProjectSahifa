# ===== BilimXazina Telegram Bot Configuration =====
#
# 1. Open Telegram and message @BotFather
# 2. Send /newbot and follow the prompts to name your bot
# 3. Copy the bot token BotFather gives you
# 4. Paste it below (this file is a template — copy it to .env)
#
# Copy this file:  cp .env.example .env
# Then fill in the value.

BOT_TOKEN=123456789:AAExampleBotTokenFromBotFather-ReplaceWithYours

# Optional but recommended: comma-separated private Telegram chat IDs
# for both owners. The bot also remembers an owner after they send /start.
OWNER_CHAT_IDS=
